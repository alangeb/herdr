#!/usr/bin/env python3
import os, pathlib, sys

args = sys.argv[1:]
state = ""

# Handle: herdr pane report-agent <pane_id> --source ID --agent LABEL --state STATE ...
if len(args) >= 2 and args[0] == "pane" and args[1] == "report-agent":
    if "--state" in args:
        state = args[args.index("--state") + 1]
elif "--state" in args:
    state = args[args.index("--state") + 1]

log = os.environ.get("HERDR_STUB_LOG")
if log and state:
    p = pathlib.Path(log)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.open("a").write(state + "\n")
sys.exit(0)
